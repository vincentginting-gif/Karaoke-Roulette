# ─────────────────────────────────────────────────────────────
#  Karaoke Roulette – Umgebungsvariablen
# ─────────────────────────────────────────────────────────────
#
# 1. Kopiere diese Datei nach ".env":
#       cp .env.example .env
#
# 2. Trage unten deine Werte ein (siehe README.md, Abschnitt "Spotify Setup").
#
# HINWEIS: Es wird KEIN Client Secret benoetigt. Diese App nutzt den
# Authorization-Code-Flow mit PKCE, der komplett im Browser laeuft.
# Trage niemals ein Client Secret in einer reinen Frontend-App ein.


# Deine Spotify "Client ID" aus dem Developer Dashboard
# (https://developer.spotify.com/dashboard -> App -> Settings)
VITE_SPOTIFY_CLIENT_ID=hier_deine_client_id_eintragen

# Die Redirect-URI, die du im Spotify-Dashboard hinterlegt hast.
# Optional: Wenn leer, wird automatisch die aktuelle Origin + "/callback"
# verwendet (z. B. http://127.0.0.1:5173/callback im lokalen Dev-Modus).
#
# WICHTIG: Der Wert hier MUSS exakt mit dem im Dashboard uebereinstimmen.
# Spotify erlaubt fuer lokale Entwicklung nur "127.0.0.1", NICHT "localhost".
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
